# Google OpenID Connect (interviewer sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
GOOGLE_SCOPES=openid email profile
GOOGLE_REFRESH_TOKEN=

# Signs the session cookie and candidate tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Optional overrides
APP_NAME=watchmecode.live
PUBLIC_URL=
# Postgres (Supabase via Vercel Marketplace injects POSTGRES_URL). Empty = local SQLite.
DATABASE_URL=
SQLITE_PATH=
RUN_TIMEOUT_SECONDS=20
INSTALL_TIMEOUT_SECONDS=120
NODE_VERSION=default

# Vercel non-interactive deploys only
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
