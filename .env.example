# Google OpenID Connect (interviewer sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
GOOGLE_SCOPES=openid email profile
GOOGLE_REFRESH_TOKEN=

# Signs the session cookie and candidate tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Optional overrides
APP_NAME=watchmecode.live
PUBLIC_URL=
# Postgres (Supabase via Vercel Marketplace injects POSTGRES_URL). Empty = local SQLite.
DATABASE_URL=
SQLITE_PATH=
RUN_TIMEOUT_SECONDS=20
INSTALL_TIMEOUT_SECONDS=120
NODE_VERSION=default

# Live co-editing hints, presence, and cursors (Supabase Realtime). Without these, browsers poll.
# The Vercel Supabase integration injects the NEXT_PUBLIC_ variants, which also work.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
REALTIME_ENABLED=true

# Integrations (Ashby, ModernLoop)
# Fernet key for stored integration credentials:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron/modernloop
CRON_SECRET=
ASHBY_PARTNER_ID=watchmecode
# Optional: candidate take-home invites via Resend
RESEND_API_KEY=
EMAIL_FROM=
# Candidate invite links stay valid this many seconds (default 30 days)
JOIN_LINK_MAX_AGE=2592000

# Multi-tenant workspaces (empty ROOT_DOMAIN = one workspace, as before)
# The apex serves the product site and the sign-in hub; <slug>.ROOT_DOMAIN serves each workspace.
ROOT_DOMAIN=
TENANT_MODE=
PLATFORM_SCHEMA=platform
TRIAL_DAYS=14
# Ed25519 seed (base64, 32 bytes) or PEM for the sign-in hub; derived from SESSION_SECRET if empty.
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
HANDOFF_PRIVATE_KEY=
# Dedicated instances only: the hub URL and its public key (from /.well-known/watchmecode-handoff.json)
AUTH_HUB_URL=
HANDOFF_PUBLIC_KEY=
TENANT_SLUG=

# Billing (scripts/stripe_setup.py writes STRIPE_PRICES and STRIPE_WEBHOOK_SECRET)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICES=
STRIPE_METER_EVENT=interview_credits

# Code execution: local (default) or sandbox (Vercel Sandbox microVM per session)
SANDBOX_BACKEND=local
SANDBOX_SESSION_MINUTES=60

# Prompt lab reviewer (Vercel AI Gateway). On Vercel it authenticates with the deployment's OIDC token;
# locally use `vercel env pull` for VERCEL_OIDC_TOKEN, or set AI_GATEWAY_API_KEY.
AI_GATEWAY_MODEL=anthropic/claude-sonnet-5.5
AI_GATEWAY_FALLBACK_MODEL=google/gemini-2.5-flash
AI_GATEWAY_API_KEY=

# Vercel non-interactive deploys only
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
