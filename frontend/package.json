{
  "name": "watchmecode-editor",
  "private": true,
  "description": "Builds the vendored CodeMirror 6 bundle at static/vendor/codemirror.js",
  "scripts": {
    "build": "esbuild editor-entry.js --bundle --format=esm --minify --target=es2020 --outfile=../static/vendor/codemirror.js"
  },
  "devDependencies": {
    "@codemirror/collab": "^6.1.1",
    "@codemirror/lang-cpp": "^6.0.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/lang-php": "^6.0.1",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.5",
    "@supabase/realtime-js": "^2.119.0",
    "codemirror": "^6.0.1",
    "esbuild": "^0.25.0"
  }
}
